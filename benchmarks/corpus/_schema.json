{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhetorical-index.example/schema/benchmark-document.json",
  "title": "Rhetorical InDEX benchmark annotation document",
  "description": "One annotated article. Only documents with adjudicationStatus='adjudicated' are scored, AND only after passing benchmarks/scripts/validate_corpus.py \u2014 an adjudicated file that fails validation is a FATAL corpus-integrity error, never a silent skip. Files whose name begins with '_' are never loaded.",
  "type": "object",
  "required": [
    "articleId",
    "genre",
    "taxonomyVersion",
    "adjudicationStatus",
    "passages",
    "annotations"
  ],
  "properties": {
    "articleId": {
      "type": "string"
    },
    "genre": {
      "enum": [
        "straight_news",
        "analysis",
        "opinion",
        "press_release",
        "other"
      ]
    },
    "sourceNote": {
      "type": "string",
      "description": "Provenance and rights note for the excerpt."
    },
    "taxonomyVersion": {
      "type": "string"
    },
    "adjudicationStatus": {
      "enum": [
        "draft",
        "annotated",
        "disputed",
        "adjudicated"
      ],
      "description": "Only 'adjudicated' contributes to metrics."
    },
    "annotatorIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "passageType",
          "text"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "passageType": {
            "enum": [
              "heading",
              "paragraph",
              "blockquote",
              "list_item",
              "caption",
              "other"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "annotations": {
      "type": "array",
      "description": "Adjudicated GOLD spans, stored separately from annotatorSubmissions. An empty array is meaningful: it asserts this article contains no instances of the implemented mechanisms.",
      "items": {
        "type": "object",
        "required": [
          "annotationId",
          "passageOrdinal",
          "startChar",
          "endChar",
          "excerpt",
          "mechanismId",
          "pressure",
          "reviewerConfidence",
          "voiceClass"
        ],
        "properties": {
          "annotationId": {
            "type": "string"
          },
          "passageOrdinal": {
            "type": "integer",
            "minimum": 0
          },
          "startChar": {
            "type": "integer",
            "minimum": 0
          },
          "endChar": {
            "type": "integer",
            "minimum": 1
          },
          "excerpt": {
            "type": "string",
            "description": "MUST equal passages[passageOrdinal].text[startChar:endChar]."
          },
          "mechanismId": {
            "type": "string"
          },
          "pressure": {
            "enum": [
              "P1",
              "P2",
              "P3",
              "P4"
            ]
          },
          "reviewerConfidence": {
            "enum": [
              "Low",
              "Medium",
              "High"
            ]
          },
          "voiceClass": {
            "enum": [
              "headline",
              "reporter",
              "editorial",
              "quoted_speaker",
              "paraphrased_source",
              "document_material",
              "uncertain"
            ]
          },
          "alternativeAcceptableMechanism": {
            "type": "string"
          },
          "nearMissRationale": {
            "type": "string"
          },
          "isHardNegativeFor": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Mechanisms a naive detector is expected to wrongly fire here."
          },
          "adjudicationNote": {
            "type": "string"
          }
        }
      }
    },
    "disagreements": {
      "type": "array",
      "description": "Retained after adjudication. Erasing disagreement destroys the calibration signal.",
      "items": {
        "type": "object",
        "required": [
          "annotationId",
          "annotatorId",
          "position"
        ],
        "properties": {
          "annotationId": {
            "type": "string"
          },
          "annotatorId": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "resolvedAs": {
            "type": "string"
          }
        }
      }
    },
    "annotatorSubmissions": {
      "type": "array",
      "description": "M-12: each annotator's ORIGINAL independent proposal, preserved verbatim and never overwritten by adjudication. Required for adjudicated documents so inter-annotator agreement (presence, mechanism, span, pressure, voice) stays computable after the fact.",
      "items": {
        "type": "object",
        "required": [
          "proposalId",
          "annotatorId",
          "mechanismId",
          "passageOrdinal",
          "startChar",
          "endChar",
          "excerpt",
          "pressure",
          "reviewerConfidence",
          "voiceClass"
        ],
        "properties": {
          "proposalId": {
            "type": "string"
          },
          "annotatorId": {
            "type": "string"
          },
          "mechanismId": {
            "type": "string"
          },
          "passageOrdinal": {
            "type": "integer",
            "minimum": 0
          },
          "startChar": {
            "type": "integer",
            "minimum": 0
          },
          "endChar": {
            "type": "integer",
            "minimum": 1
          },
          "excerpt": {
            "type": "string",
            "description": "MUST equal passages[passageOrdinal].text[startChar:endChar]."
          },
          "pressure": {
            "enum": [
              "P1",
              "P2",
              "P3",
              "P4"
            ]
          },
          "reviewerConfidence": {
            "enum": [
              "Low",
              "Medium",
              "High"
            ]
          },
          "voiceClass": {
            "enum": [
              "headline",
              "reporter",
              "editorial",
              "quoted_speaker",
              "paraphrased_source",
              "document_material",
              "uncertain"
            ]
          },
          "alternativeAcceptableMechanism": {
            "type": "string"
          },
          "nearMissRationale": {
            "type": "string"
          }
        }
      }
    },
    "resolutions": {
      "type": "array",
      "description": "Adjudicator decisions linking original proposals to the final gold annotation. Append-only; originals are never deleted.",
      "items": {
        "type": "object",
        "required": [
          "decision",
          "proposalIds"
        ],
        "properties": {
          "resolutionId": {
            "type": "string"
          },
          "proposalIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resultingAnnotationId": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "uphold_a",
              "uphold_b",
              "merge",
              "drop",
              "split",
              "unresolvable"
            ]
          },
          "adjudicatorId": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
